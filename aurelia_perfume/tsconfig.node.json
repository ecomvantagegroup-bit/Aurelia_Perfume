{
  "include": [ "vite.config.js" ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "target": "ES2022",
    "lib": [ "ES2023" ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [ "node" ],

    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true
  }
}